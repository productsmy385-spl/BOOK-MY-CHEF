# Frontend (Vite). Only VITE_ variables reach the browser — never put secret keys here.

# Clerk publishable key (pk_test_... / pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# API base URL. Leave unset in local dev: Vite proxies /api to http://localhost:8080.
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api/v1

# Optional: shown as "Help & support" in the customer menu
# VITE_SUPPORT_EMAIL=support@example.com
