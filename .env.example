# ==============================================================================
# BOOK MY CHEF - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication & SMS OTP Delivery
# Obtain from Clerk Dashboard: https://dashboard.clerk.com/
# Ensure "Sign-up with phone" and "Sign-in with phone" are ENABLED.
# Configure India (+91) in the Clerk SMS country allowlist.
# ------------------------------------------------------------------------------

# Frontend Publishable Key (Safe for browser exposure via Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Backend Private Secret Key (NEVER expose to frontend)
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Clerk Webhook Secret (For syncing user events from Clerk to PostgreSQL)
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SIGNING_SECRET

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# Internal source of truth for accounts, roles, provider profiles & bookings
# ------------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/book_my_chef
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=book_my_chef
