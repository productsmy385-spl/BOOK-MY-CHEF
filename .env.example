# ==============================================================================
# BOOK MY CHEF — backend environment (Spring Boot). Copy values into Railway.
# Missing integrations report "not configured"; nothing runs on placeholder keys.
# ==============================================================================

# --- Database -----------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/book_my_chef
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Clerk (required) ---------------------------------------------------------
# Issuer = your Clerk Frontend API URL. JWKS = <issuer>/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated web origins allowed in the token's azp claim (recommended in production)
CLERK_AUTHORIZED_PARTIES=https://your-web-domain.example
# Backend secret key: reads verified email/phone at sign-up and sends admin invitations
CLERK_SECRET_KEY=sk_test_xxx
# Svix signing secret for the Clerk webhook endpoint /api/v1/auth/webhook (user.updated, user.deleted)
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- First administrator ------------------------------------------------------
# Clerk-verified email(s) allowed to claim SUPER_ADMIN via /admin/login. Remove after setup;
# further admins are invited from the Admin team page.
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- Web origin ---------------------------------------------------------------
PUBLIC_WEB_URL=https://your-web-domain.example
CORS_ALLOWED_ORIGINS=https://your-web-domain.example,capacitor://localhost,https://localhost

# --- Razorpay (optional; only used when booking.payment_required = true) ------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- ImageKit (optional; enables photo/document uploads) -----------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Optional tuning -------------------------------------------------------------
# APP_RATE_LIMIT_AUTH_PER_MINUTE=20
# APP_RATE_LIMIT_WRITE_PER_MINUTE=60
# APP_RATE_LIMIT_SEARCH_PER_MINUTE=120
# API_DOCS_ENABLED=false
